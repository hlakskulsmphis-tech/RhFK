local function applyMovement()
   local char = LocalPlayer.Character
   if char then
      local hum = char:FindFirstChildOfClass("Humanoid")
      if hum then
         hum.WalkSpeed = WalkSpeedValue
         hum.UseJumpPower = true
         hum.JumpPower = JumpPowerValue
      end
   end
end

local function getPlayerList()
   local list = {}
   for _, p in pairs(Players:GetPlayers()) do
      if p ~= LocalPlayer then table.insert(list, p.Name) end
   end
   if #list == 0 then table.insert(list, "ไม่มีผู้เล่นอื่น") end
   return list
end

local function getRole(player)
   if not player or not player.Character then return "Innocent" end
   local backpack = player:FindFirstChild("Backpack")
   local char = player.Character
   local hasKnife = char:FindFirstChild("Knife") or (backpack and backpack:FindFirstChild("Knife"))
   local hasGun = char:FindFirstChild("Gun") or (backpack and backpack:FindFirstChild("Gun"))
   if hasKnife then return "Murderer" end
   if hasGun then return "Sheriff" end
   return "Innocent"
end

local function getRoleColor(role)
   if role == "Murderer" then return Color3.fromRGB(255, 50, 50) end
   if role == "Sheriff" then return Color3.fromRGB(50, 150, 255) end
   return Color3.fromRGB(50, 255, 50)
end

